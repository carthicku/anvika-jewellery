# Copy to frontend/.env  —  ALL values here are PUBLIC (they are compiled into the JavaScript bundle).
# Never put a secret in a VITE_ variable. See docs/development/ENVIRONMENT_VARIABLES.md.
VITE_STORE_NAME=Anvika
VITE_SITE_URL=http://localhost:5180
# Leave empty to call the API on the same origin (/api/v1/...), which is the recommended setup.
VITE_API_ORIGIN=
# Development server only: where Vite forwards /api, /media and /sitemap.xml.
VITE_API_PROXY_TARGET=http://127.0.0.1:8010
