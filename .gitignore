# --- Secrets: never commit real environment files ---
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# --- Node / frontend ---
node_modules/
dist/
coverage/
*.tsbuildinfo
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
frontend/playwright/.cache/

# --- Python / backend ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.egg-info/

# Runtime data written by the backend in development (uploads, dev email sink)
backend/var/

# --- Local embedded PostgreSQL data directory ---
.localdb/

# --- Editors / OS ---
.DS_Store
Thumbs.db
.idea/
*.swp
*.log
