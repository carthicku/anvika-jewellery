# Root environment example.
#
# The applications each have their own example file — copy those, not this one:
#   backend/.env.example   ->  backend/.env    (FastAPI settings, secrets live here)
#   frontend/.env.example  ->  frontend/.env   (PUBLIC build-time values only, never secrets)
# All variables are documented in docs/development/ENVIRONMENT_VARIABLES.md.
#
# This root file is only read by docker-compose.yml (optional, for machines with Docker).

# Local development database password used by docker-compose's PostgreSQL container.
# Development only — production uses Supabase credentials configured on the server.
POSTGRES_PASSWORD=postgres
