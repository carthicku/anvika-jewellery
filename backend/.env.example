# Copy to backend/.env for local development:  cp .env.example .env
# Every variable is explained in docs/development/ENVIRONMENT_VARIABLES.md.
# NEVER commit backend/.env. Production values belong in the hosting provider's secret store.

APP_ENV=development
# Generate with: .venv/Scripts/python -c "import secrets; print(secrets.token_urlsafe(48))"
# (If left empty in development, a random key is generated at each start and you get signed out.)
SECRET_KEY=

# Local embedded PostgreSQL (npm run db:start). For Supabase use the session-pooler URI with the
# postgresql+psycopg:// prefix and ?sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54329/anvika_dev
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54329/anvika_test

PUBLIC_SITE_URL=http://localhost:5180
ALLOWED_ORIGINS=http://localhost:5180
COOKIE_SECURE=false

STORE_NAME=Anvika
ORDER_REFERENCE_PREFIX=ANV

# simulator = development only (refused in production). razorpay = needs the three keys below.
PAYMENT_PROVIDER=simulator
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_WINDOW_MINUTES=30

# file = write emails to backend/var/mail as .eml files (development sink)
EMAIL_BACKEND=file
EMAIL_FROM=Anvika <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

STORAGE_BACKEND=local
MEDIA_ROOT=var/media

BACKGROUND_JOBS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=text
